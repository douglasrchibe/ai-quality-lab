# Copy to .env (git-ignored) and adjust. Never commit .env or real keys.
# Every value is optional for the default local setup: Ollama + qwen2.5:3b on localhost.

# --- Chatbot model ------------------------------------------------------------
# Provider: ollama (local, free) or openai (hosted, paid per token)
AIQL_LLM_PROVIDER=ollama
AIQL_LLM_MODEL=qwen2.5:3b
# AIQL_LLM_BASE_URL=http://localhost:11434
# Seconds per request. Local models on a CPU are slow; raise this if requests time out.
# AIQL_LLM_TIMEOUT=180
# AIQL_LLM_MAX_TOKENS=300

# --- DeepEval judge model (provider/model default to the chatbot settings) -----
# A separate, stronger judge gives more reliable scores than self-grading.
# AIQL_JUDGE_PROVIDER=ollama
# AIQL_JUDGE_MODEL=qwen2.5:3b
# Seconds per judge call (default 600). Also applied to DeepEval's own per-call timeout,
# whose ~85 s default is too short for a CPU-only local judge.
# AIQL_JUDGE_TIMEOUT=600
# Maximum tokens per judge reply (default 1024). Stops a small model that loops while
# producing JSON; the metric is then reported as ERROR instead of hanging.
# AIQL_JUDGE_MAX_TOKENS=1024

# --- Hosted provider (only when a provider above is "openai") ------------------
# OPENAI_API_KEY=
# AIQL_LLM_MODEL=<a model name from your provider's model list>

# --- Privacy (set automatically by the code if absent) -------------------------
# DEEPEVAL_TELEMETRY_OPT_OUT=1
