# --- Virtual environments ---
.venv/
.venv-ragas/
venv/
env/

# --- Python caches and build artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- DeepEval working folder and local results ---
.deepeval/
deepeval.db

# --- Node.js (Promptfoo) ---
node_modules/

# --- Test / tooling caches ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Local environment files and secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Generated reports (keep the folder and any explicit baselines) ---
reports/*
!reports/.gitkeep
!reports/baselines/
# Hand-written assessment reports are deliverables, not generated output.
!reports/phase_*_report.md

# --- Editor / OS noise ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# --- Claude Code local (per-user) settings ---
.claude/settings.local.json

# --- RAG vector indexes (rebuildable from data/knowledge_base) ---
.rag_index/

# --- CI artifacts produced locally by ci_check / ci_summary ---
ci-artifacts/
downloaded/
