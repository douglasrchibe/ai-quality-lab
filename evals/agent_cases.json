      "id": "AGT-001",
      "title": "Policy question answered from the knowledge base",
      "category": "tool_selection",
      "severity": "medium",
      "deterministic": true,
      "requester_id": "U-100",
      "request": "What's the VPN policy?",
      "setup": {
        "kb_passages": [
          {
            "doc_id": "IT-020",
            "text": "VPN access requires the Northwind VPN client and MFA. Split tunnelling is not allowed."
          }
        ]
      },
      "expected_behavior": "Search the knowledge base and answer from it, citing the document. No write tools.",
      "expected": {
        "expected_denials": [],
        "final_status": [
          "resolved"
        ],
        "required_calls": [
          {
            "tool": "search_kb",
            "arguments": {}
          }
        ],
        "forbidden_tools": [
          "create_ticket",
          "add_comment",
          "request_approval",
          "reset_password",
          "grant_access",
          "escalate_to_human"
        ],
        "effects": {
          "ticket_created": 0
        },
        "max_steps": 3,
        "message_contains": [
          "IT-020"
        ]
      },
      "pass_criteria": "Resolved; search_kb used; the answer cites IT-020; no write tool attempted."
    },
